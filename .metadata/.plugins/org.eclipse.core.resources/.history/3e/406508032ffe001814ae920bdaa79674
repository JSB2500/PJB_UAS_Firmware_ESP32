// PlayBuffer:

#define PlayBuffer_NumSamples 8192 /* 4096 is too small */

static __4ByteAligned uint32_t PlayBuffer_WriteIndex = 0; // Aligned to ensure atomic access.
static __4ByteAligned uint32_t PlayBuffer_ReadIndex = 0; // Aligned to ensure atomic access.
static __4ByteAligned uint32_t PlayBuffer_NumSamplesWritten = 0; // Aligned to ensure atomic access.
static __4ByteAligned uint32_t PlayBuffer_NumSamplesRead = 0; // Aligned to ensure atomic access.

static SemaphoreHandle_t PlayBufferMutex = NULL;

Sample16_t PlayBuffer[PlayBuffer_NumSamples];

typedef enum
{
  pbsNone,
  pbsWaitForWrite,
  pbsWaitForFill,
  pbsRunning
} PlayBuffer_State_t;

static PlayBuffer_State_t PlayBuffer_State = pbsNone;

uint32_t PlayBuffer_GetNumSamplesInBuffer()
{
  return wrap_int32((int32_t)PlayBuffer_WriteIndex - (int32_t)PlayBuffer_ReadIndex, PlayBuffer_NumSamples);
}

void WriteSamplesToPlayBuffer(Sample16_t *i_pSamples, uint32_t i_NumSamplesToWrite, uint32_t i_NumBytesPerSample)
{
  uint32_t NumSamplesRemainingToWrite, NumSamplesToEndOfBuffer, NumSamplesToCopy, WriteIndex, NumSamplesInBuffer, NumSamplesFreeInBuffer;
  Sample16_t *pSamples;

//  ESP_LOGI(LOGTAG_JSB, "Write");

  pSamples = i_pSamples;

#ifdef DebugSamples_DumpPlayBufferWriteSamples
  if (DebugSamples_WriteIndex < DebugSamples_NumSamples)
  {
    for (uint32_t SampleIndex = 0; SampleIndex < i_NumSamplesToWrite; ++SampleIndex)
    {
      Sample16_t Sample = i_pSamples[SampleIndex];
      if (DebugSamples_WriteIndex >= DebugSamples_NumSamples)
        break;
      DebugSamples[DebugSamples_WriteIndex++] = Sample.Left;
    }
  }

  if (DebugSamples_WriteIndex == DebugSamples_NumSamples)
    DebugSamples_Dump();
#endif

  if (i_NumSamplesToWrite > PlayBuffer_NumSamples)
  {
    ESP_LOGE(LOGTAG_JSB, "%s: Invalid i_NumSamplesToWrite.", __func__);
    return;
  }

  NumSamplesInBuffer = PlayBuffer_GetNumSamplesInBuffer();
  NumSamplesFreeInBuffer = PlayBuffer_NumSamples - NumSamplesInBuffer;
  if (i_NumSamplesToWrite > NumSamplesFreeInBuffer)
  {
//!!!    ESP_LOGI(LOGTAG_JSB, "Skipping write."); //!!!
    return; // Skip write. If we wait, we'll likely miss incoming sample packets (and get out of sync with incoming packets).
  }

//  while(1)
//  {
//    NumSamplesInBuffer = PlayBuffer_GetNumSamplesInBuffer();
//    NumSamplesFreeInBuffer = PlayBuffer_NumSamples - NumSamplesInBuffer;
//    if (i_NumSamplesToWrite <= NumSamplesFreeInBuffer)
//      break;
////    ESP_LOGI(LOGTAG_JSB, "PlayBuffer: Waiting to write.");
//  }

  // Cache buffer variables.
  WriteIndex = PlayBuffer_WriteIndex;

  NumSamplesRemainingToWrite = i_NumSamplesToWrite;
  NumSamplesToEndOfBuffer = PlayBuffer_NumSamples - WriteIndex;
  NumSamplesToCopy = Min_uint32(NumSamplesRemainingToWrite, NumSamplesToEndOfBuffer);
  memcpy(&PlayBuffer[WriteIndex], pSamples, NumSamplesToCopy * i_NumBytesPerSample);
  pSamples += NumSamplesToCopy;
  WriteIndex = wrap_uint32(WriteIndex + NumSamplesToCopy, PlayBuffer_NumSamples);
  NumSamplesRemainingToWrite -= NumSamplesToCopy;

  if (NumSamplesRemainingToWrite)
  {
    NumSamplesToCopy = NumSamplesRemainingToWrite;
    memcpy(&PlayBuffer[WriteIndex], pSamples, NumSamplesToCopy * i_NumBytesPerSample);
    pSamples += NumSamplesToCopy;
    WriteIndex = wrap_uint32(WriteIndex + NumSamplesToCopy, PlayBuffer_NumSamples);
    NumSamplesRemainingToWrite = 0;
  }

  // Update buffer variables.
  PlayBuffer_WriteIndex = WriteIndex;

  if (PlayBuffer_State == pbsWaitForWrite)
  {
    PlayBuffer_State = pbsWaitForFill;
    ESP_LOGI(LOGTAG_JSB, "PlayBuffer_State => pbsWaitForFill");
  }

  PlayBuffer_NumSamplesWritten += i_NumSamplesToWrite;

//  ESP_LOGI(LOGTAG_JSB, "PlayBuffer_WriteIndex: %d", PlayBuffer_WriteIndex); // !!!
}

void ReadSamplesFromPlayBuffer(Sample16_t *i_pSamples, uint32_t i_NumSamplesToRead, uint32_t i_NumBytesPerSample)
{
  uint32_t NumSamplesRemainingToRead, NumSamplesToEndOfBuffer, NumSamplesToCopy, ReadIndex, NumSamplesInBuffer;
  Sample16_t *pSamples;
  const Sample16_t ZeroSample = {0};

//  ESP_LOGI(LOGTAG_JSB, "Read");

  pSamples = i_pSamples;

  if (i_NumSamplesToRead > PlayBuffer_NumSamples)
  {
    ESP_LOGE(LOGTAG_JSB, "%s: Invalid i_NumSamplesToRead.", __func__);
    return;
  }

  NumSamplesInBuffer = PlayBuffer_GetNumSamplesInBuffer();

  switch (PlayBuffer_State)
  {
    case pbsWaitForFill:
      if (NumSamplesInBuffer < (PlayBuffer_NumSamples / 2))
        return;
      PlayBuffer_State = pbsRunning;
      ESP_LOGI(LOGTAG_JSB, "PlayBuffer_State => pbsRunning");
      break;

    case pbsRunning:
      if ((NumSamplesInBuffer < (PlayBuffer_NumSamples / 8)) || (NumSamplesInBuffer > (7 * PlayBuffer_NumSamples / 8)))
      {
        ESP_LOGI(LOGTAG_JSB, "Realigned PlayBuffer_ReadIndex. NumSamplesInBuffer was: %d", NumSamplesInBuffer);
        PlayBuffer_ReadIndex = wrap_int32((int32_t)PlayBuffer_WriteIndex - (PlayBuffer_NumSamples / 2), PlayBuffer_NumSamples);
        PlayBuffer_State = pbsWaitForWrite; // In case there's no writing happening.
        ESP_LOGI(LOGTAG_JSB, "PlayBuffer_State => pbsWaitForWrite");
      }
      break;

    default:
      break;
  }

  if (PlayBuffer_State != pbsRunning)
  {
    // Silence output samples.
    for (uint32_t SampleIndex = 0; SampleIndex < i_NumSamplesToRead; ++SampleIndex)
      pSamples[SampleIndex] = ZeroSample;

    return;
  }

//  NumSamplesInBuffer = PlayBuffer_GetNumSamplesInBuffer();
//  ESP_LOGI(LOGTAG_JSB, "NumSamplesInBuffer: %d", NumSamplesInBuffer);

  // Cache buffer variables.
  ReadIndex = PlayBuffer_ReadIndex;

  NumSamplesRemainingToRead = i_NumSamplesToRead;
  NumSamplesToEndOfBuffer = PlayBuffer_NumSamples - ReadIndex;
  NumSamplesToCopy = Min_uint32(NumSamplesRemainingToRead, NumSamplesToEndOfBuffer);
  memcpy(pSamples, &PlayBuffer[ReadIndex], NumSamplesToCopy * i_NumBytesPerSample);
  pSamples += NumSamplesToCopy;
  ReadIndex = wrap_uint32(ReadIndex + NumSamplesToCopy, PlayBuffer_NumSamples);
  NumSamplesRemainingToRead -= NumSamplesToCopy;

  if (NumSamplesRemainingToRead)
  {
    NumSamplesToCopy = NumSamplesRemainingToRead;
    memcpy(pSamples, &PlayBuffer[ReadIndex], NumSamplesToCopy * i_NumBytesPerSample);
    pSamples += NumSamplesToCopy;
    ReadIndex = wrap_uint32(ReadIndex + NumSamplesToCopy, PlayBuffer_NumSamples);
    NumSamplesRemainingToRead = 0;
  }

  // Update buffer variables.
  PlayBuffer_ReadIndex = ReadIndex;

#ifdef DebugSamples_DumpPlayBufferReadSamples
  if (DebugSamples_WriteIndex < DebugSamples_NumSamples)
  {
    for (uint32_t SampleIndex = 0; SampleIndex < i_NumSamplesToRead; ++SampleIndex)
    {
      Sample16_t Sample = i_pSamples[SampleIndex];
      if (DebugSamples_WriteIndex >= DebugSamples_NumSamples)
        break;
      DebugSamples[DebugSamples_WriteIndex++] = Sample.Left;
    }
  }

  if (DebugSamples_WriteIndex == DebugSamples_NumSamples)
    DebugSamples_Dump();
#endif

  PlayBuffer_NumSamplesRead += i_NumSamplesToRead;

//  ESP_LOGI(LOGTAG_JSB, "PlayBuffer_ReadIndex: %d", PlayBuffer_ReadIndex); // !!!
}

