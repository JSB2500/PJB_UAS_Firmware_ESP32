void SPI_post_setup_cb(spi_slave_transaction_t *trans)
// Called after a transaction is queued and ready for pickup by master. We use this to set the handshake line high.
{
  WRITE_PERI_REG(GPIO_OUT_W1TS_REG, (1 << SPI_GPIO_HANDSHAKE));
}

void SPI_post_trans_cb(spi_slave_transaction_t *trans)
// Called after transaction is completed. We use this to set the handshake line low.
{
  WRITE_PERI_REG(GPIO_OUT_W1TC_REG, (1 << SPI_GPIO_HANDSHAKE));
}

void SPI_Initialize()
{
  // Configure handshake line as output:
  gpio_config_t gpio_cfg;
  //
  memset(&gpio_cfg, 0, sizeof(gpio_cfg));
  //
  gpio_cfg.intr_type = GPIO_INTR_DISABLE;
  gpio_cfg.mode = GPIO_MODE_OUTPUT;
  gpio_cfg.pin_bit_mask = (1 << SPI_GPIO_HANDSHAKE);
  //
  gpio_config(&gpio_cfg);

  spi_bus_config_t spi_bus_cfg;
  //
  memset(&spi_bus_cfg, 0, sizeof(spi_bus_cfg));
  //
  spi_bus_cfg.sclk_io_num = SPI_GPIO_SCLK;
  spi_bus_cfg.mosi_io_num = SPI_GPIO_MOSI;
  spi_bus_cfg.miso_io_num = SPI_GPIO_MISO;

  spi_slave_interface_config_t spi_interface_cfg;
  //
  memset(&spi_interface_cfg, 0, sizeof(spi_interface_cfg));
  //
  spi_interface_cfg.mode = 0;
  spi_interface_cfg.spics_io_num = SPI_GPIO_SS;
  spi_interface_cfg.queue_size = 3;
  spi_interface_cfg.flags = 0;
  spi_interface_cfg.post_setup_cb = SPI_post_setup_cb;
  spi_interface_cfg.post_trans_cb = SPI_post_trans_cb;

  // Initialize SPI slave interface:
  esp_err_t ret = spi_slave_initialize(HSPI_HOST, &spi_bus_cfg, &spi_interface_cfg, 1);
  assert(ret == ESP_OK);
}

