typedef struct
{
  GUID_t Format;
  uint32_t SampleRate;
  uint16_t NumChannels;
  uint16_t NumBitsPerSampleChannel;
  uint32_t NumSamplesPerBlock;
} ESP32Command_BeBluetoothSource_t;

uint32_t BeBluetoothSource_IncomingAudio_SampleRate;
uint16_t BeBluetoothSource_IncomingAudio_NumChannels;
uint16_t BeBluetoothSource_IncomingAudio_NumBitsPerSampleChannel;
uint32_t BeBluetoothSource_IncomingAudio_NumSamplesPerBlock;

static char SPI_TransmitData[2048];
static char SPI_ReceiveData[2048];

typedef enum
{
  Identity_None = 0,
  Identity_BluetoothSource = 1
} Identity_t;

Identity_t Identity = Identity_None;

void PassthroughTask(void *pvParameter)
{
  Sample16_t *pSamples;
  esp_err_t ReturnCode;

  ESP_LOGI(LOGTAG_JSB, "Starting passthrough task.");

  ESP_LOGI(LOGTAG_JSB, "Remaining RAM (bytes): %d", esp_get_free_heap_size());

  spi_slave_transaction_t SPI_Transaction;
  memset(&SPI_Transaction, 0, sizeof(SPI_Transaction));
  memset(&SPI_TransmitData, 0, sizeof(SPI_TransmitData));
  memset(&SPI_ReceiveData, 0, sizeof(SPI_ReceiveData));

  PlayBuffer_State = pbsWaitForWrite;

  while (1)
  {
    SPI_Transaction.length = sizeof(SPI_TransmitData) << 3; // Bits!
    SPI_Transaction.tx_buffer = SPI_TransmitData;
    SPI_Transaction.rx_buffer = SPI_ReceiveData;
    do
    {
      ReturnCode = spi_slave_transmit(HSPI_HOST, &SPI_Transaction, portMAX_DELAY);
    }
    while (SPI_Transaction.trans_len == 0);

    if (ReturnCode)
    {
      ESP_LOGE(LOGTAG_JSB, "Error receiving command");
    }
    else
    {
      int NumBytesReceived = SPI_Transaction.trans_len >> 3;
      if (NumBytesReceived >= sizeof(GUID_t))
      {
        //!!!
//        char strFormat[64];
//        GUIDToString((GUID_t *)SPI_ReceiveData, strFormat);
//        ESP_LOGI(LOGTAG_JSB, "Format ID: %s\n", strFormat);

        GUID_t ESP32_BeNothing_CommandFormat0, ESP32_BeBluetoothSource_CommandFormat0, ESP32_BeBluetoothSource_DataFormat0;
        StringToGUID("{837C7FAA-9ADE-4E53-87B6-C5F42CEF40E9}", &ESP32_BeNothing_CommandFormat0);
        StringToGUID("{6B44D75A-86B2-4A89-8E04-D1ABCF16E78F}", &ESP32_BeBluetoothSource_CommandFormat0);
        StringToGUID("{4839C500-E431-42D3-9508-83009C1E31D4}", &ESP32_BeBluetoothSource_DataFormat0);

        if (GUID_IsEqual((GUID_t *)SPI_ReceiveData, &ESP32_BeNothing_CommandFormat0))
        {
          ESP_LOGI(LOGTAG_JSB, "Command: BeNothingSource");

          Identity = Identity_None;
        }
        else
        if (GUID_IsEqual((GUID_t *)SPI_ReceiveData, &ESP32_BeBluetoothSource_CommandFormat0))
        {
          static ESP32Command_BeBluetoothSource_t *pCommand = (ESP32Command_BeBluetoothSource_t *)SPI_ReceiveData;

          ESP_LOGI(LOGTAG_JSB, "Command: BeBluetoothSource SampleRate=%d NumChannels=%d NumBitsPerSampleChannel=%d NumSamplesPerBlock=%d", pCommand->SampleRate, pCommand->NumChannels, pCommand->NumBitsPerSampleChannel, pCommand->NumSamplesPerBlock);

          BeBluetoothSource_IncomingAudio_SampleRate = pCommand->SampleRate;
          BeBluetoothSource_IncomingAudio_NumChannels = pCommand->NumChannels;
          BeBluetoothSource_IncomingAudio_NumBitsPerSampleChannel = pCommand->NumBitsPerSampleChannel;
          BeBluetoothSource_IncomingAudio_NumSamplesPerBlock = pCommand->NumSamplesPerBlock;

          if (BeBluetoothSource_IncomingAudio_NumChannels != 2)
            ESP_LOGI(LOGTAG_JSB, "NumChannels is not supported.");
          else if (BeBluetoothSource_IncomingAudio_NumBitsPerSampleChannel != 16)
            ESP_LOGI(LOGTAG_JSB, "NumBitsPerSampleChannel is not supported.");
          else
            Identity = Identity_BluetoothSource;
        }
        else if (GUID_IsEqual((GUID_t *)SPI_ReceiveData, &ESP32_BeBluetoothSource_DataFormat0))
        {
          if (Identity == Identity_BluetoothSource)
          {
            if (NumBytesReceived != sizeof(GUID_t) + 2 * 2 * BeBluetoothSource_IncomingAudio_NumSamplesPerBlock)
            {
              ESP_LOGI(LOGTAG_JSB, "Unexpected number of samples.");
            }
            else
            {
              pSamples = (Sample16_t *)((GUID_t *)SPI_ReceiveData + 1);

              if(PlayMode == pmPassthrough)
              {
                if (xSemaphoreTake(PlayBufferMutex, 1000)) // !!! Crude experiment.
                {
                  WriteSamplesToPlayBuffer(pSamples, BeBluetoothSource_IncomingAudio_NumSamplesPerBlock, NumBytesPerSample);
                  xSemaphoreGive(PlayBufferMutex);
                }
              }
            }
          }
        }
        else
        {
          char strFormat[64];
          GUIDToString((GUID_t *)SPI_ReceiveData, strFormat);
          ESP_LOGI(LOGTAG_JSB, "Unrecognized command format ID: %s", strFormat);
        }
      }
      else
      {
        ESP_LOGI(LOGTAG_JSB, "Command not recognized.");
      }
    }
  }
}

void BufferedToneTask(void *pvParameter)
{
  Sample16_t *pSamples = NULL;
  const uint32_t NumSamples = 128;

  ESP_LOGI(LOGTAG_JSB, "Starting buffered tone task.");

  pSamples = calloc(NumSamples, sizeof(Sample16_t));

  GetTone(pSamples, NumSamples);

  while (1)
  {
    if (xSemaphoreTake(PlayBufferMutex, 1000)) // !!! Crude experiment.
    {
      WriteSamplesToPlayBuffer(pSamples, NumSamples, sizeof(Sample16_t));
      xSemaphoreGive(PlayBufferMutex);
    }

    vTaskDelay(1);
  }
}

void app_main()
 {
   uint32_t Previous_PlayBuffer_NumSamplesWritten = 0;
   uint32_t Previous_PlayBuffer_NumSamplesRead = 0;
   float CurrentTime = 0.0f;
   float PreviousTime = 0.0f;
   float DeltaTime;

   printf("\nApp: Bluetooth Source\n");

   ESP_LOGI(LOGTAG_JSB, "Remaining RAM (bytes): %d", esp_get_free_heap_size());

   NVS_Initialize();
   LED_Initialize();
   SPI_Initialize();
   BT_Initialize();

   ESP_LOGI(LOGTAG_JSB, "Remaining RAM (bytes): %d", esp_get_free_heap_size());

   PlayBufferMutex = xSemaphoreCreateMutex();

   PlayMode = pmPassthrough; //!!!

   switch(PlayMode)
   {
     case pmPassthrough:
       xTaskCreate(&PassthroughTask, "Passthrough", 2048, NULL, 5, NULL);
       break;

     case pmBufferedTone:
       xTaskCreate(&BufferedToneTask, "BufferedTone", 2048, NULL, 5, NULL);
       break;

     default:
       break;
   }

   gpio_set_direction(BUTTON_GPIO, GPIO_MODE_INPUT);

   while(1)
   {
     gpio_set_level(LED_GPIO, 1);

     // The apparent jitter in the incoming sample rate is due to the uncertainty of one packet, which is currently 320 bytes, in the sample period.
     CurrentTime = (uint32_t)esp_timer_get_time() / 1E6;
     DeltaTime = CurrentTime - PreviousTime;
     uint32_t NumSamplesInBuffer = PlayBuffer_GetNumSamplesInBuffer();
     uint32_t InputSampleRate = (PlayBuffer_NumSamplesWritten - Previous_PlayBuffer_NumSamplesWritten) / DeltaTime;
     uint32_t OutputSampleRate = (PlayBuffer_NumSamplesRead - Previous_PlayBuffer_NumSamplesRead) / DeltaTime;
     if (gpio_get_level(BUTTON_GPIO) == 0)
     {
       Previous_PlayBuffer_NumSamplesWritten = PlayBuffer_NumSamplesWritten;
       Previous_PlayBuffer_NumSamplesRead = PlayBuffer_NumSamplesRead;
       PreviousTime = CurrentTime;
     }

     ESP_LOGI(LOGTAG_JSB, "Num samples in buffer: %d Input sample rate: %d Output sample rate: %d", NumSamplesInBuffer, InputSampleRate, OutputSampleRate);

     gpio_set_level(LED_GPIO, 0);

     vTaskDelay(1000 / portTICK_PERIOD_MS);
   }
 }

