///////////////////////////////////////////////////////////////////////////////
// Tone:

void GetTone(Sample16_t *pSamples, uint32_t NumSamples)
{
  uint32_t SampleIndex;
  float Level_float;
  int16_t Level_int16;
  Sample16_t Sample;
  float Amplitude = 0.03f;

  for(SampleIndex = 0; SampleIndex < NumSamples; ++SampleIndex)
  {
    Level_float = Amplitude * sin(((float)SampleIndex / (float)NumSamples) * 2.0f * M_PI);
    Level_int16 = round(32767.0f * Level_float);
    Sample.Left = Level_int16;
    Sample.Right = Level_int16;
    pSamples[SampleIndex] = Sample;
  }
}

